{
	"name": "Paradox Localization Entry",
	"scopeName": "source.paradox.loc.entry",
	"injectionSelector": "L:meta.map.value.yaml",
	"patterns": [
		{ "include": "#localization_entry" }
	],
	"repository": {
		"localization_entry": {
			"begin": "^(\\s*)([\\w.-]+)(:)(\\d+)?(\\s*)(\")",
			"beginCaptures": {
				"2": { "name": "entity.name.tag.yaml" },
				"3": { "name": "punctuation.separator.map.value.yaml" },
				"4": { "name": "punctuation.separator.map.value.yaml" },
				"6": { "name": "punctuation.definition.string.begin.yaml" }
			},
			"end": "((?<!\\\\)\")|(?=^\\s*[\\w.-]+(?::\\d+)?\\s+\")",
			"applyEndPatternLast": true,
			"endCaptures": {
				"1": { "name": "punctuation.definition.string.end.yaml" }
			},
			"contentName": "string.quoted.double.yaml",
			"patterns": [
				{ "include": "source.yaml.1.2#double-escape" },
				{ "include": "source.yaml.1.1#double-escape" },
				{ "include": "source.yaml.1.0#double-escape" }
			]
		}
	}
}
