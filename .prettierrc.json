{
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "proseWrap": "never",
  "embeddedLanguageFormatting": "off",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "parser": "json-stringify"
      }
    },
    {
      "files": "*.jsonc",
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
