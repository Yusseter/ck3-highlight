{
	"name": "ck3-highlight",
	"displayName": "Crusader Kings III Highlight",
	"description": "Syntax highlight for Crusader Kings III script files",
	"version": "0.0.2",
	"publisher": "Yusseter",
	"icon": "icons/ck3.png",
	"readme": "README.md",
	"author": {
		"name": "Yusseter"
	},
	"engines": {
		"vscode": "^1.107.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"crusader kings"
	],
	"bugs": {
		"url": "https://github.com/Yusseter/ck3-highlight/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Yusseter/ck3-highlight.git"
	},
	"homepage": "https://github.com/Yusseter/ck3-highlight",
	"qna": "https://github.com/Yusseter/ck3-highlight/issues",
	"contributes": {
		"languages": [
			{
				"id": "ck3",
				"aliases": [
					"Crusader Kings III Paradox Script"
				],
	  			"extensions": [
					".txt",
					".gui",
					".info",
					".map",
					".asset",
					".mod",
					".shortcuts",
					".settings"
				],
				"configuration": "./language-configuration.json",
				"filenamePatterns": [
					"**/{Crusader Kings III,CK,CK3,1158310}/{**, mod}/*.{txt,gui,info,map,asset,mod,shortcuts,settings}"
				],
				"icon": {
					"light": "./icons/paradox_black.png",
					"dark": "./icons/paradox_white.png"
				}
			},
			{
				"id": "paradox",
				"aliases": [
					"Paradox Script"
				],
				"extensions": [
					".txt",
					".gui",
					".info",
					".map",
					".asset",
					".mod",
					".shortcuts",
					".settings"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/paradox_black.png",
					"dark": "./icons/paradox_white.png"
				}
			}
		],
		"grammars": [
			{
				"language": "ck3",
				"scopeName": "source.paradox.ck3",
				"path": "./syntaxes/ck3.tmLanguage.json",
				"injectTo": [
      				"source.paradox"
    			]
			},
			{
				"language": "paradox",
				"scopeName": "source.paradox",
				"path": "./syntaxes/paradox.tmLanguage.json"
			},
			{
				"scopeName": "source.paradox.loc",
				"injectTo": [
					"source.paradox",
					"source.yaml"
				],
				"path": "./syntaxes/localization.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "paradox-highlight.format",
				"title": "Format Paradox Scripts"
			}
		]
	},
	"main": "./src/extension.js",
	"activationEvents": []
}
